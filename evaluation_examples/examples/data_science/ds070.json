{
  "id": "ds070",
  "snapshot": "data_science",
  "instruction": "Using Jupyter Notebook, create a new notebook named `feature_target_corr.ipynb` under `/home/user/analysis_results/`. The dataset `diabetes.csv` is already located in that folder. In the notebook, load the data using pandas and compute the Pearson correlation coefficient between each numeric feature and the target variable `Outcome`. Save all correlation values in descending order of absolute magnitude to a file named `feature_target_corr.csv` with columns `Feature` and `Correlation`. Finally, identify the feature most strongly correlated with `Outcome` and write its name (only the feature name) to a text file named `strongest_target_feature.txt`.",
  "source": "https://raw.githubusercontent.com/plotly/datasets/refs/heads/master/diabetes.csv",

  "config": [
    {
      "type": "command",
      "parameters": {
        "command": ["mkdir", "-p", "/home/user/analysis_results"]
      }
    },
    {
      "type": "download",
      "parameters": {
        "files": [
          {
            "url": "https://raw.githubusercontent.com/plotly/datasets/refs/heads/master/diabetes.csv",
            "path": "/home/user/analysis_results/diabetes.csv"
          }
        ]
      }
    },
    {
      "type": "command",
      "parameters": {
        "command": [
          "bash",
          "-c",
          "cat > /home/user/analysis_results/feature_target_corr.ipynb << 'EOF'\n{\n \"cells\": [],\n \"metadata\": {},\n \"nbformat\": 4,\n \"nbformat_minor\": 5\n}\nEOF"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "python3",
          "-m",
          "notebook",
          "/home/user/analysis_results/feature_target_corr.ipynb"
        ]
      }
    }
  ],

  "trajectory": "trajectories/ds070",
