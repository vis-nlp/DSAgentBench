{
  "id": "ds055",
  "snapshot": "data_science",
  "instruction": "Using Jupyter Notebook, create a new notebook named `credit_correlation.ipynb` under `/home/user/analysis_results/`. The dataset `data.csv` is already in that folder. In the notebook, load the dataset using pandas. Compute the Pearson correlation coefficient between `RevolvingUtilizationOfUnsecuredLines` and `SeriousDlqin2yrs`. Round the correlation value to three decimals and save it in a text file named `credit_corr.txt` inside the same directory. The file should contain only the numeric correlation value (e.g., 0.123 or -0.456).",
  "source": "https://raw.githubusercontent.com/plotly/datasets/refs/heads/master/data.csv",

  "config": [
    {
      "type": "command",
      "parameters": {
        "command": ["mkdir", "-p", "/home/user/analysis_results"]
      }
    },
    {
      "type": "download",
      "parameters": {
        "files": [
          {
            "url": "https://raw.githubusercontent.com/plotly/datasets/refs/heads/master/data.csv",
            "path": "/home/user/analysis_results/data.csv"
          }
        ]
      }
    },
    {
      "type": "command",
      "parameters": {
        "command": [
          "bash",
          "-c",
          "cat > /home/user/analysis_results/credit_correlation.ipynb << 'EOF'\n{\n \"cells\": [],\n \"metadata\": {},\n \"nbformat\": 4,\n \"nbformat_minor\": 5\n}\nEOF"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "python3",
          "-m",
          "notebook",
          "/home/user/analysis_results/credit_correlation.ipynb"
        ]
      }
    }
  ],

  "trajectory": "trajectories/ds055",
  "related_apps": ["jupyter", "python"],

