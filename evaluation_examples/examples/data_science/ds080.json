{
  "id": "ds080",
  "snapshot": "data_science",
  "instruction": "Using Jupyter Notebook, create a notebook named `region_polarization_analysis.ipynb` inside `/home/user/analysis_results/`. The dataset `district_density.csv` is already present in that directory. In the notebook, load the dataset using pandas and group the data by `region`. For each region, compute the following statistics: (1) the average of `dem_margin`, (2) the average of `gop_perc`, and (3) the average of the absolute value of `swing` to measure electoral volatility. Save the resulting table as `region_polarization.csv` in the same directory, with columns: `region`, `avg_dem_margin`, `avg_gop_perc`, `avg_abs_swing` (rounded to three decimals).",
  "source": "https://raw.githubusercontent.com/plotly/datasets/refs/heads/master/district_density.csv",

  "config": [
    {
      "type": "command",
