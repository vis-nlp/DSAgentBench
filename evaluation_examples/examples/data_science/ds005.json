{
  "id": "ds005",
  "snapshot": "data_science",
  "instruction": "Using Visual Studio Code, create a new Python script called wine_visualization.py in the /home/user/analysis_results/ directory. The dataset winequality-red.csv is already in the same folder. Load it using pandas, and create visualizations that show how alcohol content affects wine quality. The first chart should be a scatter plot of alcohol versus quality saved as chart1.png, and the second should be a boxplot showing the distribution of quality across different alcohol levels saved as chart2.png.",
  "source": "https://raw.githubusercontent.com/plotly/datasets/master/winequality-red.csv",

  "config": [
