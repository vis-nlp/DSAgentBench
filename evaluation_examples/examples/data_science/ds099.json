          "cat > /home/user/analysis_results/iris_correlation_analysis.ipynb << 'EOF'\n{\n \"cells\": [],\n \"metadata\": {},\n \"nbformat\": 4,\n \"nbformat_minor\": 5\n}\nEOF"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "python3",
          "-m",
          "notebook", 
          "/home/user/analysis_results/iris_correlation_analysis.ipynb"
        ]
      }
    }
  ],
  "trajectory": "trajectories/ds099",
