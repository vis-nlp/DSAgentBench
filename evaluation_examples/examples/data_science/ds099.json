{
  "id": "ds099",
  "snapshot": "data_science",
  "instruction": "Using Jupyter Notebook, create a new notebook called iris_correlation_analysis.ipynb in the /home/user/analysis_results/ directory. In this notebook, load the dataset iris-data.csv which is already available in that directory and explore correlations among all numeric features. Perform the following: (1) create a heatmap of the correlation matrix and save it as correlation_heatmap.png; (2) create a pairplot of all numeric columns colored by class and save it as pairplot.png. Ensure both charts include proper titles, labels, and are clearly readable.",
  "source": "https://raw.githubusercontent.com/plotly/datasets/refs/heads/master/iris-data.csv",
  "config": [
    {
      "type": "command",
      "parameters": {
        "command": ["mkdir", "-p", "/home/user/analysis_results"]
      }
