          "/home/user/analysis_results/lifestyle_kaggle.py"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "code",
          "/home/user/analysis_results/lifestyle_kaggle.py"
        ]
      }
    }
  ],

  "trajectory": "trajectories/ds129",
  "related_apps": ["vscode", "python"],

  "evaluator": {
    "postconfig": [
      {
