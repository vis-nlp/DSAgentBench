{
  "id": "ds129",
  "snapshot": "data_science",
  "instruction": "Using Visual Studio Code, create a new Python script called `lifestyle_kaggle.py` in the `/home/user/analysis_results/` directory. The Life Style dataset will already be downloaded from Kaggle (`jockeroika/life-style-data`) and placed into the same directory. Load all CSV files in that folder, print their column names, and save them into a text file `lifestyle_kaggle_columns.txt` in the same directory.",
  "source": "kaggle://jockeroika/life-style-data",

  "config": [
