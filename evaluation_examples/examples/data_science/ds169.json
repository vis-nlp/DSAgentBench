        ]
      }
    },
    {
      "type": "command",
      "parameters": {
        "command": ["touch", "/home/user/analysis_results/credit_approval_visualization.py"]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": ["code", "/home/user/analysis_results/credit_approval_visualization.py"]
      }
    }
  ],

  "trajectory": "trajectories/ds169",
  "related_apps": ["vscode", "python"],

  "evaluator": {
