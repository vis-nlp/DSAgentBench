        "type": "sleep",
        "parameters": {
          "seconds": 2.0
        }
      },
      {
        "type": "execute",
        "parameters": {
          "command": ["python", "-c", "import pyautogui; pyautogui.hotkey('ctrl','s');"]
        }
      },
      {
        "type": "sleep",
        "parameters": {
          "seconds": 1.0
        }
      }
