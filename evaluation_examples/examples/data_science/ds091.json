{
  "id": "ds091",
  "snapshot": "data_science",
  "instruction": "Using Jupyter Notebook, create a new notebook named `iris_ratio_per_class.ipynb` in `/home/user/analysis_results/`. The dataset `iris-data.csv` is already available in that directory. In the notebook, load the dataset using pandas. For each row, compute two new ratios: (1) `petal_length / sepal_length`, and (2) `petal_width / sepal_width`. Then, group the data by the species column (class) and compute the average of these two ratios for each species. Save the result as `iris_ratio_summary.csv` with columns: `class, avg_petal_to_sepal_length, avg_petal_to_sepal_width`, rounding all numeric values to three decimals.",
  "source": "https://raw.githubusercontent.com/plotly/datasets/refs/heads/master/iris-data.csv",

  "config": [
    {
      "type": "command",
      "parameters": {
        "command": ["mkdir", "-p", "/home/user/analysis_results"]
      }
    },
    {
      "type": "download",
      "parameters": {
        "files": [
          {
            "url": "https://raw.githubusercontent.com/plotly/datasets/refs/heads/master/iris-data.csv",
            "path": "/home/user/analysis_results/iris-data.csv"
          }
        ]
      }
    },
    {
      "type": "command",
      "parameters": {
        "command": [
          "bash",
          "-c",
          "cat > /home/user/analysis_results/iris_ratio_per_class.ipynb << 'EOF'\n{\n \"cells\": [],\n \"metadata\": {},\n \"nbformat\": 4,\n \"nbformat_minor\": 5\n}\nEOF"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "python3",
          "-m",
          "notebook",
          "/home/user/analysis_results/iris_ratio_per_class.ipynb"
        ]
      }
    }
  ],

  "trajectory": "trajectories/ds091",
