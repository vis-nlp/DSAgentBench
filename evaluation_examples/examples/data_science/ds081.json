{
  "id": "ds081",
  "snapshot": "data_science",
  "instruction": "Using Jupyter Notebook, create a notebook named `regional_swing_counts.ipynb` under `/home/user/analysis_results/`. The dataset `district_density.csv` is already in that folder. In the notebook, load the data using pandas. For each district, determine the direction of swing: label as 'Pro-Democratic' if `swing` > 0 and 'Pro-Republican' if `swing` < 0. Then group by `region` and count how many districts swung in each direction. Save the results as `regional_swing_counts.csv` in the same directory with columns: `region`, `pro_dem_count`, and `pro_gop_count`.",
  "source": "https://raw.githubusercontent.com/plotly/datasets/refs/heads/master/district_density.csv",

  "config": [
    {
      "type": "command",
      "parameters": {
        "command": ["mkdir", "-p", "/home/user/analysis_results"]
      }
    },
    {
      "type": "download",
      "parameters": {
        "files": [
          {
            "url": "https://raw.githubusercontent.com/plotly/datasets/refs/heads/master/district_density.csv",
            "path": "/home/user/analysis_results/district_density.csv"
          }
        ]
      }
    },
    {
      "type": "command",
      "parameters": {
        "command": [
          "bash",
          "-c",
          "cat > /home/user/analysis_results/regional_swing_counts.ipynb << 'EOF'\n{\n \"cells\": [],\n \"metadata\": {},\n \"nbformat\": 4,\n \"nbformat_minor\": 5\n}\nEOF"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "python3",
          "-m",
          "notebook",
          "/home/user/analysis_results/regional_swing_counts.ipynb"
        ]
      }
    }
  ],

  "trajectory": "trajectories/ds081",
  "related_apps": ["jupyter", "python"],

  "evaluator": {
    "postconfig": [
      {
        "type": "activate_window",
        "parameters": {
          "window_name": "Jupyter Notebook"
        }
      },
      {
        "type": "sleep",
        "parameters": {
          "seconds": 2.0
        }
      }
    ],
    "func": "evaluate_regional_swing_counts",
    "result": {
      "type": "vm_file",
      "multi": true,
      "path": [
        "/home/user/analysis_results/regional_swing_counts.ipynb",
        "/home/user/analysis_results/district_density.csv",
        "/home/user/analysis_results/regional_swing_counts.csv"
      ],
      "dest": [
        "regional_swing_counts.ipynb",
        "district_density.csv",
        "regional_swing_counts.csv"
      ]
    },
    "expected": {
      "type": "rule",
      "rules": {
        "notebook_exists": true,
        "expected_file": "regional_swing_counts.csv",
        "required_libraries": ["pandas"]
      }
    }
  },

  "proxy": false,
  "fixed_ip": false,
