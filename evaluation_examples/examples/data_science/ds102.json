{
  "id": "ds102",
  "snapshot": "data_science",
  "instruction": "Using Jupyter Notebook, create a new notebook called iris_comparative_feature_range.ipynb in the /home/user/analysis_results/ directory. In this notebook, load the dataset iris-data.csv which is already available in that directory and compare statistical summaries visually. Perform the following: (1) create a bar chart showing the mean feature values per class and save it as mean_feature_bar.png; (2) create a bar chart showing the standard deviation of each feature per class and save it as std_feature_bar.png. Ensure both charts have clear titles, labeled axes, and legends.",
  "source": "https://raw.githubusercontent.com/plotly/datasets/refs/heads/master/iris-data.csv",
  "config": [
    {
      "type": "command",
      "parameters": {
        "command": ["mkdir", "-p", "/home/user/analysis_results"]
      }
    },
    {
      "type": "download",
      "parameters": {
        "files": [
          {
            "url": "https://raw.githubusercontent.com/plotly/datasets/refs/heads/master/iris-data.csv",
            "path": "/home/user/analysis_results/iris-data.csv"
          }
        ]
      }
    },
    {
      "type": "command",
      "parameters": {
        "command": [
          "bash",
          "-c",
          "cat > /home/user/analysis_results/iris_comparative_feature_range.ipynb << 'EOF'\n{\n \"cells\": [],\n \"metadata\": {},\n \"nbformat\": 4,\n \"nbformat_minor\": 5\n}\nEOF"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "python3",
          "-m",
          "notebook", 
          "/home/user/analysis_results/iris_comparative_feature_range.ipynb"
        ]
      }
    }
  ],
  "trajectory": "trajectories/ds102",
  "related_apps": ["jupyter", "python"],
