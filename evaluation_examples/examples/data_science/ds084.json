{
  "id": "ds084",
  "snapshot": "data_science",
  "instruction": "Using Jupyter Notebook, create a notebook called `high_magnitude_earthquakes.ipynb` in `/home/user/analysis_results/`. The dataset `earthquakes-23k.csv` is already in that folder. In the notebook, load the dataset using pandas. Filter all records where `Magnitude ≥ 7.0`. Count how many such earthquakes occurred and save this count to `highmag_count.txt`. Then compute the average latitude and longitude of these filtered earthquakes and save them to `highmag_location.csv` with columns: `AvgLatitude`, `AvgLongitude` (rounded to three decimals).",
  "source": "https://raw.githubusercontent.com/plotly/datasets/refs/heads/master/earthquakes-23k.csv",

  "config": [
    {
      "type": "command",
      "parameters": {
        "command": ["mkdir", "-p", "/home/user/analysis_results"]
      }
    },
    {
      "type": "download",
      "parameters": {
        "files": [
          {
            "url": "https://raw.githubusercontent.com/plotly/datasets/refs/heads/master/earthquakes-23k.csv",
            "path": "/home/user/analysis_results/earthquakes-23k.csv"
          }
        ]
      }
    },
    {
      "type": "command",
      "parameters": {
        "command": [
          "bash",
          "-c",
          "cat > /home/user/analysis_results/high_magnitude_earthquakes.ipynb << 'EOF'\n{\n \"cells\": [],\n \"metadata\": {},\n \"nbformat\": 4,\n \"nbformat_minor\": 5\n}\nEOF"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "python3",
          "-m",
          "notebook",
          "/home/user/analysis_results/high_magnitude_earthquakes.ipynb"
        ]
      }
    }
  ],

  "trajectory": "trajectories/ds084",
