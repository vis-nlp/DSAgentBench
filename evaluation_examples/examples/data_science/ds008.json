{
  "id": "ds008",
  "snapshot": "data_science",
  "instruction": "Create a Python script named walmart_xgb_classifier.py in the /home/user/analysis_results/ directory. Using the dataset 1962_2006_walmart_store_openings.csv, train an XGBoost classifier (xgboost.XGBClassifier) to predict whether a store became a Supercenter (conversion == 1) using LAT, LON, st, county, and YEAR as features. Split the last 10 percent of rows as the validation set. Compute Accuracy, Precision (for class 1), and Recall (for class 1) on the validaiton set, each rounded to three decimals, and save them in xgb_metrics.txt in this format: accuracy, precision, recall (comma separated, same line).",
  "source": "https://raw.githubusercontent.com/plotly/datasets/master/1962_2006_walmart_store_openings.csv",

  "config": [
    {
      "type": "command",
      "parameters": {
        "command": ["mkdir", "-p", "/home/user/analysis_results"]
      }
    },
    {
      "type": "download",
      "parameters": {
        "files": [
          {
            "url": "https://raw.githubusercontent.com/plotly/datasets/master/1962_2006_walmart_store_openings.csv",
            "path": "/home/user/analysis_results/1962_2006_walmart_store_openings.csv"
          }
        ]
      }
    },
    {
      "type": "command",
      "parameters": {
        "command": ["touch", "/home/user/analysis_results/walmart_xgb_classifier.py"]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": ["code", "/home/user/analysis_results/walmart_xgb_classifier.py"]
      }
    }
  ],

  "trajectory": "trajectories/ds008",
  "related_apps": ["vscode", "python"],

  "evaluator": {
    "postconfig": [
      {
        "type": "activate_window",
        "parameters": { "window_name": "Visual Studio Code" }
      },
      {
        "type": "sleep",
        "parameters": { "seconds": 2.0 }
      },
      {
        "type": "execute",
        "parameters": {
          "command": ["python", "-c", "import pyautogui; pyautogui.hotkey('ctrl','s');"]
        }
      },
      {
        "type": "sleep",
        "parameters": { "seconds": 1.0 }
      }
    ],
    "func": "evaluate_xgb_metrics_classifier",
    "result": {
      "type": "vm_file",
